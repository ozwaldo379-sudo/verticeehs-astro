---
// ParticleBackground.astro
// Subtle particle canvas that uses the 3 Vértice EHS logo colors:
//   #2E9E3C (Hazard Green), #1A5CE6 (Logo Blue), #F8FAFC (Sovereign White)
// Zero external dependencies — pure Canvas 2D API.
---

<canvas id="particle-canvas" aria-hidden="true"></canvas>

<script>
(function () {
  const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
  if (!canvas) return;

  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  // Respect reduced motion preference
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- BRAND COLORS from the Vértice EHS logo (3 colors) ---
  const COLORS = [
    'rgba(46, 158, 60,',   // Hazard Green
    'rgba(26, 92, 230,',   // Logo Blue
    'rgba(248, 250, 252,', // Sovereign White
  ];

  let W = window.innerWidth;
  let H = window.innerHeight;

  function resize() {
    W = window.innerWidth;
    H = document.documentElement.scrollHeight;
    canvas.width = W;
    canvas.height = H;
  }

  resize();
  window.addEventListener('resize', resize);

  // --- Particle factory ---
  function randomBetween(a: number, b: number) {
    return a + Math.random() * (b - a);
  }

  interface Particle {
    x: number; y: number;
    vx: number; vy: number;
    radius: number;
    color: string;
    alpha: number;
    alphaDir: number;
  }

  const COUNT = prefersReduced ? 0 : Math.min(Math.floor((W * H) / 18000), 120);

  function createParticle(): Particle {
    const color = COLORS[Math.floor(Math.random() * COLORS.length)];
    return {
      x: randomBetween(0, W),
      y: randomBetween(0, H),
      vx: randomBetween(-0.18, 0.18),
      vy: randomBetween(-0.12, 0.12),
      radius: randomBetween(0.8, 2.2),
      color,
      alpha: randomBetween(0.06, 0.22),
      alphaDir: Math.random() > 0.5 ? 1 : -1,
    };
  }

  const particles: Particle[] = Array.from({ length: COUNT }, createParticle);

  // --- Render loop ---
  let raf: number;

  function draw() {
    ctx!.clearRect(0, 0, W, H);

    for (const p of particles) {
      // Gentle alpha pulse (breathing effect)
      p.alpha += 0.0003 * p.alphaDir;
      if (p.alpha > 0.22 || p.alpha < 0.04) p.alphaDir *= -1;

      ctx!.beginPath();
      ctx!.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
      ctx!.fillStyle = `${p.color}${p.alpha.toFixed(3)})`;
      ctx!.fill();

      // Move
      p.x += p.vx;
      p.y += p.vy;

      // Wrap around
      if (p.x < -10) p.x = W + 10;
      if (p.x > W + 10) p.x = -10;
      if (p.y < -10) p.y = H + 10;
      if (p.y > H + 10) p.y = -10;
    }

    raf = requestAnimationFrame(draw);
  }

  draw();

  // Pause when tab is hidden to save resources
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) cancelAnimationFrame(raf);
    else draw();
  });
})();
</script>

<style>
  #particle-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 1;
  }
</style>
