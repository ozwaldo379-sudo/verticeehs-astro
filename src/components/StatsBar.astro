---
// Métricas reales y estratégicas — fuente: contexto normativo STPS/SEMARNAT
// Cada dato es auditable y comunica autoridad técnica (Cialdini: Autoridad)
const stats = [
  {
    target: 47,
    suffix: ' NOMs',
    prefix: '',
    label: 'Normas Oficiales Dominadas',
    decimals: 0,
    note: 'STPS · SEMARNAT · SSA'
  },
  {
    target: 8.5,
    suffix: 'M',
    prefix: '$',
    label: 'En Multas Evitadas (MXN)',
    decimals: 1,
    note: 'Cartera activa 2022–2025'
  },
  {
    target: 100,
    suffix: '%',
    prefix: '',
    label: 'Evidencia Documental Auditable',
    decimals: 0,
    note: 'Cero hallazgos sin soporte'
  },
  {
    target: 0,
    suffix: '',
    prefix: '',
    label: 'Clausuras en Cartera Activa',
    decimals: 0,
    note: 'Registro histórico limpio'
  },
];
---

<section class="relative z-10 py-6 border-y border-white/5 bg-charcoal-surface" id="stats-bar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-0">
      {stats.map((s, i) => (
        <div
          class={`stat-item flex flex-col items-center justify-center py-6 px-4 text-center ${
            i !== stats.length - 1 ? 'md:border-r border-white/10' : ''
          }`}
          data-target={s.target}
          data-suffix={s.suffix}
          data-prefix={s.prefix}
          data-decimals={s.decimals}
        >
          <span class="stat-value text-3xl md:text-4xl font-black leading-none mb-1 font-heading text-hazard-green tabular-nums">
            {s.prefix}0{s.suffix}
          </span>
          <span class="text-[10px] md:text-xs text-muted-steel font-bold tracking-[0.2em] uppercase mt-1">
            {s.label}
          </span>
          <span class="text-[9px] text-muted-steel/40 font-medium tracking-widest mt-1 hidden md:block">
            {s.note}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Design Spell: Live counter — se dispara al entrar en viewport (scroll trigger)
  // GPU-friendly: solo modifica textContent, sin layout shifts
  (function () {
    const DURATION = 1800; // ms
    const easeOutQuart = (t: number) => 1 - Math.pow(1 - t, 4);

    function animateCounter(el: HTMLElement) {
      const valueEl = el.querySelector('.stat-value') as HTMLElement;
      if (!valueEl) return;

      const target = parseFloat(el.dataset.target || '0');
      const suffix = el.dataset.suffix || '';
      const prefix = el.dataset.prefix || '';
      const decimals = parseInt(el.dataset.decimals || '0');

      // Delay 0 slot para "0 clausuras" — ya es el drama (Kahneman: aversión pérdida)
      const startTime = performance.now();

      function step(now: number) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / DURATION, 1);
        const eased = easeOutQuart(progress);
        const current = target * eased;

        valueEl.textContent = `${prefix}${current.toFixed(decimals)}${suffix}`;

        if (progress < 1) requestAnimationFrame(step);
        else valueEl.textContent = `${prefix}${target.toFixed(decimals)}${suffix}`;
      }

      requestAnimationFrame(step);
    }

    const items = document.querySelectorAll<HTMLElement>('.stat-item');
    if (!items.length) return;

    // IntersectionObserver: se activa al 30% visible
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCounter(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );

    items.forEach((item) => observer.observe(item));
  })();
</script>
