---
const stats = [
  { value: '18+', label: 'Servicios Especializados' },
  { value: '500+', label: 'Empresas Atendidas' },
  { value: '100%', label: 'Documentos Auditables' },
  { value: '0', label: 'Clausuras en Cartera Activa' },
];
---

<section class="relative z-10 py-6 border-y border-white/5 bg-charcoal-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-0">
      {stats.map((s, i) => (
        <div 
          class={`flex flex-col items-center justify-center py-5 px-4 text-center ${
            i !== stats.length - 1 ? 'md:border-r border-white/10' : ''
          }`}
        >
          <span class="text-3xl md:text-4xl font-bold leading-none mb-1 font-heading text-hazard-green">
            {s.value}
          </span>
          <span class="text-[10px] md:text-xs text-muted-steel font-medium tracking-widest uppercase">
            {s.label}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
