---
import '../styles/global.css';
import ParticleBackground from '../components/ParticleBackground.astro';

interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const { title, description = "Vértice EHS - Consultoría en Normatividad STPS, Medio Ambiente y Sistemas de Gestión", robots = "index, follow" } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={Astro.url.href} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/favicon.svg" />
    <meta property="og:site_name" content="Vértice EHS" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/favicon.svg" />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- Schema.org (LegalService / Organization) para AI Search -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LegalService",
        "name": "Vértice EHS",
        "description": "Consultoría normativa STPS y Medio Ambiente para la industria manufacturera en México.",
        "url": "https://vertice-ehs.mx",
        "logo": "https://vertice-ehs.mx/favicon.svg",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Puebla",
          "addressCountry": "MX"
        },
        "sameAs": []
      }
    </script>
    
  </head>
  <body class="bg-deep-void text-sovereign-white min-h-screen flex flex-col font-body selection:bg-hazard-green selection:text-deep-void relative">
    
    <!-- Global ambient particle background -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <ParticleBackground />
    </div>

    <!-- Premium Header (Siempre oscuro para que destaquen las partículas) -->
    <header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-white/5 backdrop-blur-xl bg-deep-void/70 text-sovereign-white" id="main-header">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="h-20 flex items-center justify-between">
          <div class="flex-shrink-0">
            <a href="/" class="group flex items-center gap-3">
              <img src="/logo.png" alt="Vértice EHS Logo" class="h-10 w-auto object-contain" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
              <span class="text-2xl font-extrabold font-heading tracking-tighter text-sovereign-white group-hover:text-hazard-green transition-colors hidden" style="display: none;">
                VÉRTICE<span class="text-hazard-green group-hover:text-sovereign-white">.</span>EHS
              </span>
            </a>
          </div>
          
          <nav class="hidden md:flex items-center space-x-10">
            <a href="/" class="text-xs font-bold uppercase tracking-[0.2em] text-muted-steel hover:text-hazard-green transition-all">Inicio</a>
            <a href="/catalogo" class="text-xs font-bold uppercase tracking-[0.2em] text-muted-steel hover:text-hazard-green transition-all">Catálogo NOMs</a>
            <a href="/clientes" class="text-xs font-bold uppercase tracking-[0.2em] text-sovereign-white hover:text-hazard-green transition-all relative group">
              <span class="relative z-10" style="text-shadow: 0 0 8px rgba(255, 255, 255, 0.4);">Clientes</span>
              <div class="absolute -inset-2 bg-hazard-green/10 rounded-lg blur-sm opacity-50 group-hover:opacity-100 transition-opacity"></div>
            </a>
          </nav>

          <div class="hidden md:flex items-center gap-4">
            <a href="https://wa.me/522224596850" target="_blank" class="btn-primary text-[10px] font-black uppercase tracking-widest px-6 py-3">
              Blindaje Normativo
            </a>
          </div>

          <!-- Mobile Menu Button -->
          <button class="md:hidden relative z-50 text-sovereign-white" id="mobile-menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu-panel">
            <svg id="mobile-menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
            <svg id="mobile-menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu-overlay" class="md:hidden fixed inset-0 z-40 bg-deep-void/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300" aria-hidden="true"></div>

    <!-- Mobile Menu Panel -->
    <nav id="mobile-menu-panel" class="md:hidden fixed top-20 left-4 right-4 z-40 mt-2 adn-glass-card bg-charcoal-surface/95 border border-white/5 rounded-2xl p-6 -translate-y-4 opacity-0 pointer-events-none transition-all duration-300" aria-hidden="true">
      <div class="flex flex-col gap-6">
        <a href="/" class="mobile-menu-link text-sm font-bold uppercase tracking-[0.2em] text-muted-steel hover:text-hazard-green transition-colors">Inicio</a>
        <a href="/catalogo" class="mobile-menu-link text-sm font-bold uppercase tracking-[0.2em] text-muted-steel hover:text-hazard-green transition-colors">Catálogo NOMs</a>
        <a href="/clientes" class="mobile-menu-link text-sm font-bold uppercase tracking-[0.2em] text-sovereign-white hover:text-hazard-green transition-colors">Clientes</a>
        <div class="h-px bg-white/10"></div>
        <a href="https://wa.me/522224596850" target="_blank" class="mobile-menu-link btn-primary text-center text-[10px] font-black uppercase tracking-widest px-6 py-3">
          Blindaje Normativo
        </a>
      </div>
    </nav>

    <div class="relative z-10 flex-grow flex flex-col">
      <main class="flex-grow pt-20 relative">
        <slot />
      </main>

      <!-- Premium Footer -->
      <footer class="bg-charcoal-surface/50 border-t border-white/5 py-24 relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent to-deep-void opacity-50"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-24">
            <div class="col-span-1 md:col-span-2">
              <div class="flex items-center gap-3">
                <img src="/logo.png" alt="Vértice EHS Logo" class="h-12 w-auto object-contain" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
              </div>
              <p class="mt-8 text-xl text-muted-steel leading-relaxed max-w-md">
                Ingeniería estratégica en cumplimiento normativo y blindaje industrial para el mercado mexicano.
              </p>
            </div>

            <div>
              <h3 class="text-[10px] font-black text-hazard-green uppercase tracking-[0.4em] mb-8">SOLUCIONES</h3>
              <ul class="space-y-4">
                <li><a href="/catalogo#seguridad" class="text-sm font-medium text-muted-steel hover:text-sovereign-white transition-colors">Seguridad STPS</a></li>
                <li><a href="/catalogo#medio-ambiente" class="text-sm font-medium text-muted-steel hover:text-sovereign-white transition-colors">Medio Ambiente</a></li>
                <li><a href="/catalogo#sistemas" class="text-sm font-medium text-muted-steel hover:text-sovereign-white transition-colors">ISO 45001 / 14001</a></li>
              </ul>
            </div>

            <div>
              <h3 class="text-[10px] font-black text-hazard-green uppercase tracking-[0.4em] mb-8">CONTACTO</h3>
              <ul class="space-y-4">
                <li class="flex items-center gap-3 text-sm font-medium text-muted-steel">
                  <svg class="w-4 h-4 text-hazard-green/60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  Puebla, México
                </li>
                <li>
                  <a href="mailto:ventas@verticeehs.com" class="flex items-center gap-3 text-sm font-medium text-muted-steel hover:text-sovereign-white transition-colors group">
                    <svg class="w-4 h-4 text-hazard-green/60 group-hover:text-hazard-green transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    ventas@verticeehs.com
                  </a>
                </li>
              </ul>
            </div>
          </div>

          <div class="mt-24 pt-12 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6">
            <p class="text-[10px] font-bold text-muted-steel uppercase tracking-widest">
              &copy; {new Date().getFullYear()} VÉRTICE EHS CONSULTORÍA. TODOS LOS DERECHOS RESERVADOS.
            </p>
            <div class="flex gap-8">
              <a href="#" class="text-[10px] font-bold text-muted-steel hover:text-hazard-green uppercase tracking-widest transition-colors">Privacidad</a>
              <a href="#" class="text-[10px] font-bold text-muted-steel hover:text-hazard-green uppercase tracking-widest transition-colors">Términos</a>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <script>
      // Header scroll effect
      const header = document.getElementById('main-header');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
          header?.classList.add('py-2', 'shadow-2xl', 'bg-deep-void/90');
          header?.classList.remove('py-0', 'bg-deep-void/70');
        } else {
          header?.classList.remove('py-2', 'shadow-2xl', 'bg-deep-void/90');
          header?.classList.add('py-0', 'bg-deep-void/70');
        }
      });

      // Mobile Menu Toggle Logic
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenuIconOpen = document.getElementById('mobile-menu-icon-open');
      const mobileMenuIconClose = document.getElementById('mobile-menu-icon-close');
      const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
      const mobileMenuPanel = document.getElementById('mobile-menu-panel');

      function setMobileMenuOpen(open) {
          mobileMenuBtn?.setAttribute('aria-expanded', String(open));
          mobileMenuIconOpen?.classList.toggle('hidden', open);
          mobileMenuIconClose?.classList.toggle('hidden', !open);
          [mobileMenuOverlay, mobileMenuPanel].forEach((el) => {
              el?.classList.toggle('opacity-0', !open);
              el?.classList.toggle('pointer-events-none', !open);
              el?.setAttribute('aria-hidden', String(!open));
          });
          mobileMenuPanel?.classList.toggle('-translate-y-4', !open);
          document.body.classList.toggle('overflow-hidden', open);
      }

      mobileMenuBtn?.addEventListener('click', () => {
          setMobileMenuOpen(mobileMenuBtn.getAttribute('aria-expanded') !== 'true');
      });

      mobileMenuOverlay?.addEventListener('click', () => setMobileMenuOpen(false));

      document.querySelectorAll('.mobile-menu-link').forEach((link) => {
          link.addEventListener('click', () => setMobileMenuOpen(false));
      });

      // Cerrar menú móvil si el viewport cruza a desktop (ej. rotar a horizontal en tablets)
      window.addEventListener('resize', () => {
          if (window.innerWidth >= 768) setMobileMenuOpen(false);
      });
    </script>
  </body>
</html>
