---
import '../styles/global.css';
import ParticleBackground from '../components/ParticleBackground.astro';

interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const { title, description = "Vértice EHS - Consultoría en Normatividad STPS, Medio Ambiente y Sistemas de Gestión", robots = "index, follow" } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={Astro.url.href} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/favicon.svg" />
    <meta property="og:site_name" content="Vértice EHS" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/favicon.svg" />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- Schema.org (LegalService / Organization) para AI Search -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LegalService",
        "name": "Vértice EHS",
        "description": "Consultoría normativa STPS y Medio Ambiente para la industria manufacturera en México.",
        "url": "https://vertice-ehs.mx",
        "logo": "https://vertice-ehs.mx/favicon.svg",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Puebla",
          "addressCountry": "MX"
        },
        "sameAs": []
      }
    </script>
    
    <!-- Theme Script (Day/Night Mode) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light'; // Por defecto claro como lo solicitó el usuario
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body class="bg-slate-50 dark:bg-deep-void text-slate-900 dark:text-sovereign-white min-h-screen flex flex-col font-body selection:bg-hazard-green selection:text-deep-void transition-colors duration-300 relative">
    
    <!-- Global ambient particle background -->
    <div class="fixed inset-0 z-0 pointer-events-none">
      <ParticleBackground />
    </div>

    <!-- Premium Header (Siempre oscuro para que destaquen las partículas) -->
    <header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-white/5 backdrop-blur-xl bg-deep-void/70 text-sovereign-white" id="main-header">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="h-20 flex items-center justify-between">
          <div class="flex-shrink-0">
            <a href="/" class="group flex items-center gap-3">
              <img src="/logo.png" alt="Vértice EHS Logo" class="h-10 w-auto object-contain" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
              <span class="text-2xl font-extrabold font-heading tracking-tighter text-sovereign-white group-hover:text-hazard-green transition-colors hidden" style="display: none;">
                VÉRTICE<span class="text-hazard-green group-hover:text-sovereign-white">.</span>EHS
              </span>
            </a>
          </div>
          
          <nav class="hidden md:flex items-center space-x-10">
            <a href="/" class="text-xs font-bold uppercase tracking-[0.2em] text-muted-steel hover:text-hazard-green transition-all">Inicio</a>
            <a href="/catalogo" class="text-xs font-bold uppercase tracking-[0.2em] text-muted-steel hover:text-hazard-green transition-all">Catálogo NOMs</a>
            <a href="/#ADN" class="text-xs font-bold uppercase tracking-[0.2em] text-muted-steel hover:text-hazard-green transition-all">Autoridad</a>
            <a href="/clientes" class="text-xs font-bold uppercase tracking-[0.2em] text-sovereign-white hover:text-hazard-green transition-all relative group">
              <span class="relative z-10" style="text-shadow: 0 0 8px rgba(255, 255, 255, 0.4);">Clientes</span>
              <div class="absolute -inset-2 bg-hazard-green/10 rounded-lg blur-sm opacity-50 group-hover:opacity-100 transition-opacity"></div>
            </a>
          </nav>

          <div class="hidden md:flex items-center gap-4">
            <!-- Botón de Día y Noche -->
            <button id="theme-toggle" type="button" class="text-muted-steel hover:text-sovereign-white hover:bg-white/10 dark:hover:bg-white/10 rounded-full p-2.5 transition-all">
              <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
              <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
            </button>
            <a href="https://wa.me/522224596850" target="_blank" class="btn-primary text-[10px] font-black uppercase tracking-widest px-6 py-3">
              Blindaje Normativo
            </a>
          </div>

          <!-- Mobile Menu Button -->
          <button class="md:hidden text-sovereign-white" id="mobile-menu-btn">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Envolvemos main y footer con fondos sólidos en light mode para tapar las partículas, dejándolas solo en el header -->
    <div class="relative z-10 bg-slate-50 dark:bg-transparent flex-grow flex flex-col transition-colors duration-300">
      <main class="flex-grow pt-20 relative">
        <slot />
      </main>

      <!-- Premium Footer (Se adaptará a claro u oscuro) -->
      <footer class="bg-slate-100 dark:bg-charcoal-surface/50 border-t border-slate-200 dark:border-white/5 py-24 relative overflow-hidden transition-colors duration-300">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent to-slate-200 dark:to-deep-void opacity-50"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-24">
            <div class="col-span-1 md:col-span-2">
              <div class="flex items-center gap-3">
                <img src="/logo.png" alt="Vértice EHS Logo" class="h-12 w-auto object-contain dark:brightness-100 brightness-0" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
              </div>
              <p class="mt-8 text-xl text-slate-600 dark:text-muted-steel leading-relaxed max-w-md">
                Ingeniería estratégica en cumplimiento normativo y blindaje industrial para el mercado mexicano.
              </p>
            </div>
            
            <div>
              <h3 class="text-[10px] font-black text-hazard-green uppercase tracking-[0.4em] mb-8">SOLUCIONES</h3>
              <ul class="space-y-4">
                <li><a href="/catalogo#seguridad" class="text-sm font-medium text-slate-500 dark:text-muted-steel hover:text-slate-900 dark:hover:text-sovereign-white transition-colors">Seguridad STPS</a></li>
                <li><a href="/catalogo#medio-ambiente" class="text-sm font-medium text-slate-500 dark:text-muted-steel hover:text-slate-900 dark:hover:text-sovereign-white transition-colors">Medio Ambiente</a></li>
                <li><a href="/catalogo#sistemas" class="text-sm font-medium text-slate-500 dark:text-muted-steel hover:text-slate-900 dark:hover:text-sovereign-white transition-colors">ISO 45001 / 14001</a></li>
              </ul>
            </div>
            
            <div>
              <h3 class="text-[10px] font-black text-hazard-green uppercase tracking-[0.4em] mb-8">CONTACTO</h3>
              <ul class="space-y-4">
                <li class="flex items-center gap-3 text-sm font-medium text-slate-500 dark:text-muted-steel">
                  <svg class="w-4 h-4 text-hazard-green/60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  Puebla, México
                </li>
                <li>
                  <a href="mailto:ventas@verticeehs.com" class="flex items-center gap-3 text-sm font-medium text-slate-500 dark:text-muted-steel hover:text-slate-900 dark:hover:text-sovereign-white transition-colors group">
                    <svg class="w-4 h-4 text-hazard-green/60 group-hover:text-hazard-green transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    ventas@verticeehs.com
                  </a>
                </li>
              </ul>
            </div>
          </div>
          
          <div class="mt-24 pt-12 border-t border-slate-200 dark:border-white/5 flex flex-col md:flex-row justify-between items-center gap-6">
            <p class="text-[10px] font-bold text-slate-400 dark:text-muted-steel uppercase tracking-widest">
              &copy; {new Date().getFullYear()} VÉRTICE EHS CONSULTORÍA. TODOS LOS DERECHOS RESERVADOS.
            </p>
            <div class="flex gap-8">
              <a href="#" class="text-[10px] font-bold text-slate-400 dark:text-muted-steel hover:text-hazard-green uppercase tracking-widest transition-colors">Privacidad</a>
              <a href="#" class="text-[10px] font-bold text-slate-400 dark:text-muted-steel hover:text-hazard-green uppercase tracking-widest transition-colors">Términos</a>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <script>
      // Header scroll effect
      const header = document.getElementById('main-header');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
          header?.classList.add('py-2', 'shadow-2xl', 'bg-deep-void/90');
          header?.classList.remove('py-0', 'bg-deep-void/70');
        } else {
          header?.classList.remove('py-2', 'shadow-2xl', 'bg-deep-void/90');
          header?.classList.add('py-0', 'bg-deep-void/70');
        }
      });

      // Day/Night Toggle Logic
      const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
      const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
      const themeToggleBtn = document.getElementById('theme-toggle');

      if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          themeToggleLightIcon?.classList.remove('hidden');
      } else {
          themeToggleDarkIcon?.classList.remove('hidden');
      }

      themeToggleBtn?.addEventListener('click', function() {
          themeToggleDarkIcon?.classList.toggle('hidden');
          themeToggleLightIcon?.classList.toggle('hidden');

          if (localStorage.getItem('theme')) {
              if (localStorage.getItem('theme') === 'light') {
                  document.documentElement.classList.add('dark');
                  localStorage.setItem('theme', 'dark');
              } else {
                  document.documentElement.classList.remove('dark');
                  localStorage.setItem('theme', 'light');
              }
          } else {
              if (document.documentElement.classList.contains('dark')) {
                  document.documentElement.classList.remove('dark');
                  localStorage.setItem('theme', 'light');
              } else {
                  document.documentElement.classList.add('dark');
                  localStorage.setItem('theme', 'dark');
              }
          }
      });
    </script>
  </body>
</html>
