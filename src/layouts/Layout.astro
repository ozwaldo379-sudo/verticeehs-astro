---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Vértice EHS - Consultoría en Normatividad STPS, Medio Ambiente y Sistemas de Gestión" } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={Astro.url.href} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/favicon.svg" />
    <meta property="og:site_name" content="Vértice EHS" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/favicon.svg" />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- Schema.org (LegalService / Organization) para AI Search -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LegalService",
        "name": "Vértice EHS",
        "description": "Consultoría normativa STPS y Medio Ambiente para la industria manufacturera en México.",
        "url": "https://vertice-ehs.mx",
        "logo": "https://vertice-ehs.mx/favicon.svg",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Puebla",
          "addressCountry": "MX"
        },
        "sameAs": []
      }
    </script>
  </head>
  <body class="bg-deep-void text-sovereign-white min-h-screen flex flex-col font-body selection:bg-hazard-green selection:text-deep-void">
    <!-- Premium Header -->
    <header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-white/5 backdrop-blur-xl bg-deep-void/40" id="main-header">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="h-20 flex items-center justify-between">
          <div class="flex-shrink-0">
            <a href="/" class="group flex items-center gap-2">
              <span class="text-2xl font-extrabold font-heading tracking-tighter text-sovereign-white group-hover:text-hazard-green transition-colors">
                VÉRTICE<span class="text-hazard-green group-hover:text-sovereign-white">.</span>EHS
              </span>
            </a>
          </div>
          
          <nav class="hidden md:flex items-center space-x-10">
            <a href="/" class="text-xs font-bold uppercase tracking-[0.2em] text-muted-steel hover:text-hazard-green transition-all">Inicio</a>
            <a href="/catalogo" class="text-xs font-bold uppercase tracking-[0.2em] text-muted-steel hover:text-hazard-green transition-all">Catálogo NOMs</a>
            <a href="/#ADN" class="text-xs font-bold uppercase tracking-[0.2em] text-muted-steel hover:text-hazard-green transition-all">Autoridad</a>
          </nav>

          <div class="hidden md:flex items-center">
            <a href="https://wa.me/522224596850" target="_blank" class="btn-primary text-[10px] font-black uppercase tracking-widest px-6 py-3">
              Blindaje Normativo
            </a>
          </div>

          <!-- Mobile Menu Button -->
          <button class="md:hidden text-sovereign-white" id="mobile-menu-btn">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <main class="flex-grow pt-20">
      <slot />
    </main>

    <!-- Premium Footer -->
    <footer class="bg-charcoal-surface/50 border-t border-white/5 py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-transparent to-deep-void opacity-50"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-24">
          <div class="col-span-1 md:col-span-2">
            <span class="text-3xl font-black font-heading text-sovereign-white tracking-tighter">
              VÉRTICE<span class="text-hazard-green">.</span>EHS
            </span>
            <p class="mt-8 text-xl text-muted-steel leading-relaxed max-w-md">
              Ingeniería estratégica en cumplimiento normativo y blindaje industrial para el mercado mexicano.
            </p>
          </div>
          
          <div>
            <h3 class="text-[10px] font-black text-hazard-green uppercase tracking-[0.4em] mb-8">SOLUCIONES</h3>
            <ul class="space-y-4">
              <li><a href="/catalogo#seguridad" class="text-sm font-medium text-muted-steel hover:text-sovereign-white transition-colors">Seguridad STPS</a></li>
              <li><a href="/catalogo#medio-ambiente" class="text-sm font-medium text-muted-steel hover:text-sovereign-white transition-colors">Medio Ambiente</a></li>
              <li><a href="/catalogo#sistemas" class="text-sm font-medium text-muted-steel hover:text-sovereign-white transition-colors">ISO 45001 / 14001</a></li>
            </ul>
          </div>
          
          <div>
            <h3 class="text-[10px] font-black text-hazard-green uppercase tracking-[0.4em] mb-8">CONTACTO</h3>
            <ul class="space-y-4">
              <li class="flex items-center gap-3 text-sm font-medium text-muted-steel">
                <svg class="w-4 h-4 text-hazard-green/60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Puebla, México
              </li>
              <li>
                <a href="mailto:ventas@verticeehs.com" class="flex items-center gap-3 text-sm font-medium text-muted-steel hover:text-sovereign-white transition-colors group">
                  <svg class="w-4 h-4 text-hazard-green/60 group-hover:text-hazard-green transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  ventas@verticeehs.com
                </a>
              </li>
              <li>
                <a href="mailto:oswaldo.galan@verticeehs.com" class="flex items-center gap-3 text-sm font-medium text-muted-steel hover:text-sovereign-white transition-colors group">
                  <svg class="w-4 h-4 text-hazard-green/60 group-hover:text-hazard-green transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  oswaldo.galan@verticeehs.com
                </a>
              </li>
              <li>
                <a href="mailto:emanuel.torres@verticeehs.com" class="flex items-center gap-3 text-sm font-medium text-muted-steel hover:text-sovereign-white transition-colors group">
                  <svg class="w-4 h-4 text-hazard-green/60 group-hover:text-hazard-green transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  emanuel.torres@verticeehs.com
                </a>
              </li>
              <li>
                <a href="tel:+522224596850" class="flex items-center gap-3 text-sm font-medium text-muted-steel hover:text-sovereign-white transition-colors group">
                  <svg class="w-4 h-4 text-hazard-green/60 group-hover:text-hazard-green transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  +52 222 459 6850
                </a>
              </li>
              <li>
                <a href="tel:+522213050039" class="flex items-center gap-3 text-sm font-medium text-muted-steel hover:text-sovereign-white transition-colors group">
                  <svg class="w-4 h-4 text-hazard-green/60 group-hover:text-hazard-green transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  +52 221 305 0039
                </a>
              </li>
              <li>
                <a href="tel:+522229314656" class="flex items-center gap-3 text-sm font-medium text-muted-steel hover:text-sovereign-white transition-colors group">
                  <svg class="w-4 h-4 text-hazard-green/60 group-hover:text-hazard-green transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  +52 222 931 4656
                </a>
              </li>
            </ul>
          </div>
        </div>
        
        <div class="mt-24 pt-12 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6">
          <p class="text-[10px] font-bold text-muted-steel uppercase tracking-widest">
            &copy; {new Date().getFullYear()} VÉRTICE EHS CONSULTORÍA. TODOS LOS DERECHOS RESERVADOS.
          </p>
          <div class="flex gap-8">
            <a href="#" class="text-[10px] font-bold text-muted-steel hover:text-hazard-green uppercase tracking-widest transition-colors">Privacidad</a>
            <a href="#" class="text-[10px] font-bold text-muted-steel hover:text-hazard-green uppercase tracking-widest transition-colors">Términos</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Header scroll effect
      const header = document.getElementById('main-header');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
          header?.classList.add('py-2', 'shadow-2xl', 'bg-deep-void/90');
          header?.classList.remove('py-0', 'bg-deep-void/40');
        } else {
          header?.classList.remove('py-2', 'shadow-2xl', 'bg-deep-void/90');
          header?.classList.add('py-0', 'bg-deep-void/40');
        }
      });
    </script>
  </body>
</html>
