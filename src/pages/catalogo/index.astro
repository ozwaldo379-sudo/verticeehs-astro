---
import Layout from '../../layouts/Layout.astro';
import HeroCatalogo from '../../components/catalogo/HeroCatalogo.astro';
import StatsCounter from '../../components/catalogo/StatsCounter.astro';
import ManifestoQuote from '../../components/catalogo/ManifestoQuote.astro';
import FullCatalog from '../../components/catalogo/FullCatalog.astro';
---

<Layout title="Catálogo de Servicios NOMs | Vértice EHS">
  <div class="bg-deep-void min-h-screen">
    <HeroCatalogo />
    <StatsCounter />
    <ManifestoQuote />
    <FullCatalog />

    <!-- Specialized Consultation Banner -->
    <section class="pb-32 pt-16 relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
         <div class="adn-animated-border">
            <div class="bg-charcoal-surface px-10 py-12 rounded-3xl flex flex-col md:flex-row items-center justify-between gap-10">
              <div class="max-w-2xl">
                <h3 class="text-2xl md:text-3xl font-bold font-heading text-sovereign-white mb-4">¿Requiere una NOM fuera de este catálogo?</h3>
                <p class="text-muted-steel text-lg font-medium">Contamos con una red de especialistas certificados para cualquier requerimiento técnico de la STPS o SEMARNAT.</p>
              </div>
              <a href="https://wa.me/522224596850" target="_blank" class="btn-primary px-10 py-5 text-lg font-black whitespace-nowrap group">
                <span class="flex items-center gap-2">
                  Consultar Especialista
                  <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </span>
              </a>
            </div>
         </div>
      </div>
    </section>
  </div>
</Layout>
