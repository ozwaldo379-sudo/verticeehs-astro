---
import Layout from '../../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const dir = path.join(process.cwd(), 'src/data/cotizaciones');
  
  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir, { recursive: true });
  }
  
  const files = fs.readdirSync(dir).filter(file => file.endsWith('.html') || file.endsWith('.astro'));
  
  if (files.length === 0) {
    return [
      {
        params: { folio: 'ejemplo' },
        props: { 
          content: `
            <div class="text-center py-8">
              <h1 class="text-3xl font-extrabold font-heading text-sovereign-white mb-4">Cotización de Ejemplo</h1>
              <p class="text-muted-steel mb-4">Coloque sus archivos HTML de cotizaciones en la carpeta <code>src/data/cotizaciones/</code>.</p>
            </div>
          `,
          isFullHtml: false
        } 
      }
    ];
  }
  
  return files.map(file => {
    const folio = file.replace(/\.(html|astro)$/, '');
    const content = fs.readFileSync(path.join(dir, file), 'utf-8');
    const isFullHtml = content.includes('<!DOCTYPE') || content.includes('<html') || content.includes('<body');
    
    return {
      params: { folio },
      props: { content, isFullHtml }
    };
  });
}

const { folio } = Astro.params;
const { content, isFullHtml } = Astro.props;
---

{isFullHtml ? (
  // Si es un documento HTML completo, se sirve tal cual (independiente)
  <Fragment set:html={content} />
) : (
  // Si es un fragmento de HTML, se envuelve en el layout de Vértice EHS para mantener la estética
  // y se le añade 'noindex, nofollow' para proteger la privacidad de los datos de los clientes.
  <Layout 
    title={`Cotización ${folio} | Vértice EHS`} 
    description={`Visualización de la cotización de Vértice EHS - Folio ${folio}`}
    robots="noindex, nofollow"
  >
    <div class="py-16 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="adn-glass-card p-8 md:p-12 relative overflow-hidden bg-charcoal-surface border border-white/5 rounded-3xl">
        <Fragment set:html={content} />
      </div>
    </div>
  </Layout>
)}
