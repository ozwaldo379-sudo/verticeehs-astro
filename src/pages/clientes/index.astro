---
import Layout from '../../layouts/Layout.astro';

// This is the main Client Portal entry page
---

<Layout
  title="Portal de Clientes | Vértice EHS"
  description="Accede a tus cotizaciones, estudios y expedientes legales en tu entorno seguro de Vértice EHS."
>
  <section class="py-32 relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      {/* Header Section */}
      <div class="text-center max-w-3xl mx-auto mb-20">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/5 backdrop-blur-md mb-8">
          <span class="w-2 h-2 rounded-full animate-pulse bg-hazard-green shadow-[0_0_8px_rgba(46,158,60,0.8)]"></span>
          <span class="text-xs font-bold uppercase tracking-widest text-sovereign-white">Portal Exclusivo</span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold font-heading leading-[1.1] mb-6 text-sovereign-white">
          Tu ecosistema de <span class="gradient-title block mt-2">Seguridad y Salud</span>
        </h1>
        <p class="text-lg md:text-xl max-w-2xl mx-auto text-muted-steel font-medium">
          Accede a tus estudios normativos, audita tu expediente legal y revisa cotizaciones de forma rápida y segura, respaldado por Vértice EHS.
        </p>
      </div>

      {/* Grid de Herramientas */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

        {/* Card 1: Cotizaciones */}
        <a href="/clientes/cotizaciones" class="adn-glass-card p-10 group relative overflow-hidden block">
          <div class="absolute top-0 left-0 w-full h-1 bg-logo-blue opacity-70 group-hover:opacity-100 transition-opacity"></div>
          <div class="absolute inset-0 bg-gradient-to-b from-logo-blue/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
          <div class="relative z-10">
            <div class="h-16 w-16 rounded-2xl bg-logo-blue/10 text-logo-blue flex items-center justify-center mb-8 border border-logo-blue/20 group-hover:bg-logo-blue/20 transition-all">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold font-heading mb-4 text-sovereign-white group-hover:text-logo-blue transition-colors">Cotizaciones</h3>
            <p class="text-muted-steel mb-8 leading-relaxed font-medium">Revisa, descarga y aprueba tus propuestas de servicio mediante tu folio asignado.</p>
            <div class="text-logo-blue font-bold inline-flex items-center group/link">
              Acceder
              <svg class="w-5 h-5 ml-2 transform group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </div>
          </div>
        </a>

        {/* Card 2: Estudios STPS */}
        <div class="adn-glass-card p-10 group relative overflow-hidden cursor-pointer" onclick="alert('Funcionalidad en construcción. Se vinculará con Google Drive.')">
          <div class="absolute top-0 left-0 w-full h-1 bg-hazard-green opacity-70 group-hover:opacity-100 transition-opacity"></div>
          <div class="absolute inset-0 bg-gradient-to-b from-hazard-green/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
          <div class="relative z-10">
            <div class="h-16 w-16 rounded-2xl bg-hazard-green/10 text-hazard-green flex items-center justify-center mb-8 border border-hazard-green/20 group-hover:bg-hazard-green/20 transition-all">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold font-heading mb-4 text-sovereign-white group-hover:text-hazard-green transition-colors">Estudios STPS</h3>
            <p class="text-muted-steel mb-8 leading-relaxed font-medium">Consulta informes, resultados de evaluaciones de agentes químicos y normas de la STPS.</p>
            <div class="text-hazard-green font-bold inline-flex items-center group/link">
              Ingresar Folio
              <svg class="w-5 h-5 ml-2 transform group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </div>
          </div>
        </div>

        {/* Card 3: Expediente Legal */}
        <div class="adn-glass-card p-10 group relative overflow-hidden cursor-pointer" onclick="alert('Funcionalidad en construcción. Se vinculará con Google Drive.')">
          <div class="absolute top-0 left-0 w-full h-1 bg-amber-gold opacity-70 group-hover:opacity-100 transition-opacity"></div>
          <div class="absolute inset-0 bg-gradient-to-b from-amber-gold/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
          <div class="relative z-10">
            <div class="h-16 w-16 rounded-2xl bg-amber-gold/10 text-amber-gold flex items-center justify-center mb-8 border border-amber-gold/20 group-hover:bg-amber-gold/20 transition-all">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2v-3.5" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold font-heading mb-4 text-sovereign-white group-hover:text-amber-gold transition-colors">Expediente Legal</h3>
            <p class="text-muted-steel mb-8 leading-relaxed font-medium">Tus evidencias, auditorías y certificaciones organizadas y siempre disponibles.</p>
            <div class="text-amber-gold font-bold inline-flex items-center group/link">
              Acceso Corporativo
              <svg class="w-5 h-5 ml-2 transform group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </div>
          </div>
        </div>

      </div>

      {/* Trust/Value Section */}
      <div class="adn-glass-card mt-16 p-10 md:p-14 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-logo-blue/10 rounded-full blur-[80px] pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-40 h-40 bg-hazard-green/10 rounded-full blur-[60px] pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-10">
          <div class="md:w-2/3 space-y-4">
            <h3 class="text-2xl font-bold font-heading text-sovereign-white">Seguridad, Trazabilidad y Confianza</h3>
            <p class="text-muted-steel text-sm md:text-base leading-relaxed font-medium">
              En Vértice EHS entendemos que tu información es el activo más importante. Nuestro ecosistema utiliza infraestructura en la nube empresarial (Google Workspace) para garantizar que tus expedientes y resultados estén siempre disponibles con la máxima encriptación.
            </p>
          </div>
          <div class="md:w-1/3 flex justify-center md:justify-end">
            <div class="flex -space-x-4">
              <div class="w-16 h-16 rounded-full border-4 border-deep-void flex items-center justify-center bg-white/10 backdrop-blur-md shadow-lg">
                <svg class="w-6 h-6 text-sovereign-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              </div>
              <div class="w-16 h-16 rounded-full border-4 border-deep-void flex items-center justify-center bg-white/10 backdrop-blur-md shadow-lg">
                <svg class="w-6 h-6 text-hazard-green" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>
