---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Vértice EHS - Consultoría en Normatividad STPS, Medio Ambiente y Sistemas de Gestión" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-deep-void text-sovereign-white min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 backdrop-blur-md bg-deep-void/80 border-b border-charcoal-surface">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex-shrink-0">
          <a href="/" class="text-2xl font-bold font-heading text-sovereign-white">
            Vértice<span class="text-hazard-green">.</span>EHS
          </a>
        </div>
        <nav class="hidden md:flex space-x-8">
          <a href="/" class="text-muted-steel hover:text-sovereign-white transition-colors">Inicio</a>
          <a href="/catalogo/" class="text-muted-steel hover:text-sovereign-white transition-colors">Catálogo NOMs</a>
        </nav>
        <div class="hidden md:flex">
          <a href="/contacto" class="btn-primary text-sm px-4 py-2">
            Evaluar Riesgo
          </a>
        </div>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-charcoal-surface border-t border-deep-void py-12 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <span class="text-xl font-bold font-heading text-sovereign-white">
              Vértice<span class="text-hazard-green">.</span>EHS
            </span>
            <p class="mt-4 text-muted-steel text-sm">
              Blindaje técnico y legal para la industria manufacturera en México.
            </p>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-sovereign-white uppercase tracking-wider">Servicios</h3>
            <ul class="mt-4 space-y-2">
              <li><a href="/catalogo" class="text-sm text-muted-steel hover:text-hazard-green transition-colors">Seguridad STPS</a></li>
              <li><a href="/catalogo" class="text-sm text-muted-steel hover:text-hazard-green transition-colors">Medio Ambiente</a></li>
              <li><a href="/catalogo" class="text-sm text-muted-steel hover:text-hazard-green transition-colors">Sistemas de Gestión</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-sovereign-white uppercase tracking-wider">Contacto</h3>
            <ul class="mt-4 space-y-2 text-sm text-muted-steel">
              <li>contacto@vertice-ehs.mx</li>
              <li>Querétaro, México</li>
            </ul>
          </div>
        </div>
        <div class="mt-12 pt-8 border-t border-deep-void flex flex-col md:flex-row justify-between items-center">
          <p class="text-sm text-muted-steel">
            &copy; {new Date().getFullYear()} Vértice EHS. Todos los derechos reservados.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
